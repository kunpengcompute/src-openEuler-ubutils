#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

WORK_DIR := $(CURDIR)/debian/build-tree
SRC_DIR := $(CURDIR)
BUILD_DIR := $(WORK_DIR)/build
PKG_DIR := $(CURDIR)/debian/ubutils
BINARY_PKG := ubutils
DIST_TAG := velinux

%:
	dh $@

override_dh_auto_configure:
	cmake -Wno-dev -S $(SRC_DIR) -B $(BUILD_DIR) \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_build:
	cmake --build $(BUILD_DIR) --parallel
	version="$$(dpkg-parsechangelog -S Version | sed 's/+.*//; s/-.*//')"; \
	man_date="$$(LC_ALL=C date -u -d "$$(dpkg-parsechangelog -S Date)" '+%d %B %Y')"; \
	sed \
		-e "s/@TODAY@/$$man_date/" \
		-e "s/@VERSION@/ubutils-$$version/" \
		-e 's#@IDSDIR@#/usr/share/hwdata#' \
		< $(SRC_DIR)/lsub.man > $(WORK_DIR)/lsub.8; \
	sed \
		-e "s/@TODAY@/$$man_date/" \
		-e "s/@VERSION@/ubutils-$$version/" \
		-e 's#@IDSDIR@#/usr/share/hwdata#' \
		< $(SRC_DIR)/setub.man > $(WORK_DIR)/setub.8

override_dh_auto_install:
	install -D -m 0755 $(BUILD_DIR)/lsub/lsub $(PKG_DIR)/usr/bin/lsub
	install -D -m 0755 $(BUILD_DIR)/setub/setub $(PKG_DIR)/usr/bin/setub
	install -D -m 0644 $(SRC_DIR)/ub.ids $(PKG_DIR)/usr/share/hwdata/ub.ids
	install -D -m 0644 $(WORK_DIR)/lsub.8 $(PKG_DIR)/usr/share/man/man8/lsub.8
	install -D -m 0644 $(WORK_DIR)/setub.8 $(PKG_DIR)/usr/share/man/man8/setub.8

override_dh_auto_clean:
	rm -rf $(WORK_DIR)
